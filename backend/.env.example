# Hindsight Configuration
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=incident-agent

# Groq Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=4000
GROQ_REASONING_EFFORT=false

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Environment  (development | staging | production)
ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# API Security
# ---------------------------------------------------------------------------
# Required when ENVIRONMENT != development and host is not loopback.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_API_KEY=

# ---------------------------------------------------------------------------
# Rate limiting / concurrency / budgets (0 = disabled)
# ---------------------------------------------------------------------------
MAX_CONCURRENT_CALLS=4
MAX_DAILY_CALLS=0
MAX_MONTHLY_CALLS=0

# ---------------------------------------------------------------------------
# Memory settings
# ---------------------------------------------------------------------------
# Set false only in dev workspaces where cross-environment recall is intentional
RECALL_SAME_ENV_ONLY=true
# Set true to allow staging/dev incidents to be retained in the shared bank
RETAIN_NON_PRODUCTION=false
# Redact emails, tokens, AWS keys, PEM blocks before retaining or sending to LLM
MEMORY_REDACTION=true
